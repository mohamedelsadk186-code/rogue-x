# Same "Web application" OAuth Client ID as backend GOOGLE_CLIENT_ID (must match exactly).
# Set in Render Static Site Environment before build/redeploy.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Apple Sign In Services ID (used by Apple JS `clientId`)
VITE_APPLE_CLIENT_ID=com.yourcompany.roguex.web
